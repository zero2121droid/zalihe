# Copy to deploy/.env (never committed) and fill in. Plain KEY=value lines without quotes or spaces,
# because backup.sh reads this file too.

# The domain Caddy serves and gets the certificate for, and the address users open.
DOMAIN=app.example.rs
APP_URL=https://app.example.rs

# A long random password: openssl rand -hex 32
POSTGRES_PASSWORD=

# SMTP of the email provider (Brevo, Resend…). Security: StartTls (587) or SslOnConnect (465).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURITY=StartTls
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=upozorenja@example.rs

# Nightly backups (backup.sh): where they're kept on the server, for how many days, and the rclone
# remote they're copied to. An encrypted ("crypt") remote, e.g. b2-crypt:zalihe; empty = server only.
BACKUP_DIR=/var/backups/zalihe
BACKUP_KEEP_DAYS=30
BACKUP_REMOTE=

# Only for the local check on a computer where 80/443 are taken.
# HTTP_PORT=8081
# HTTPS_PORT=8443
